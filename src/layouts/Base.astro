---
import "../styles/global.css";
import { t, localizePath, delocalizePath, type Lang } from "../lib/i18n";

const { title, description, lang = "en" as Lang } = Astro.props;
const s = t(lang);
const path = Astro.url.pathname;
const nav = [
  [localizePath(lang, "/"), s.nav.concepts],
  [localizePath(lang, "/quiz"), s.nav.quiz],
  [localizePath(lang, "/playground"), s.nav.playground],
];
const switchHref = localizePath(s.otherLang, delocalizePath(path));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description ?? s.baseDescription} />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cjrtnc.leaningtech.com" crossorigin />
  </head>
  <body class="min-h-screen">
    <header class="border-b border-rule">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
        <a href={localizePath(lang, "/")} class="ui text-sm font-bold tracking-tight">
          advanced<span class="text-cobalt">.java</span>
        </a>
        <nav class="flex items-center gap-6">
          {nav.map(([href, label]) => (
            <a
              href={href}
              class="eyebrow hover:text-ink"
              style={path === href ? "color: var(--cobalt)" : ""}
            >
              {label}
            </a>
          ))}
          <a href={switchHref} class="eyebrow hover:text-ink" style="opacity: 0.6">
            {s.otherLangLabel}
          </a>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-6 py-12">
      <slot />
    </main>

    <footer class="mt-16 border-t border-rule">
      <div class="mx-auto max-w-5xl px-6 py-8">
        <p class="eyebrow">{s.footer}</p>
        <p class="mt-3 text-sm text-muted">
          {s.madeWith} <span aria-hidden="true">❤️</span> {s.by}{" "}
          <a
            href="https://megapulse.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="underline hover:text-ink"
          >
            megapulse
          </a>
        </p>
      </div>
    </footer>
  </body>
</html>
