---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import questions from "../data/questions.json";

const concepts = (await getCollection("concepts")).sort(
  (a, b) => a.data.offset - b.data.offset
);

const topics = [...new Set(concepts.map((c) => c.data.topic))];
const countFor = (slug: string) => questions.filter((q) => q.concept === slug).length;
---

<Base title="Advanced Java — concepts">
  <section class="mb-16 border-b border-rule pb-12">
    <span class="eyebrow">{concepts.length} concepts · {questions.length} questions</span>
    <h1 class="ui mt-4 max-w-2xl text-[2.75rem] font-bold leading-[1.08] tracking-tight">
      The parts of Java that behave differently from how they read.
    </h1>
    <p class="mt-5 max-w-xl leading-relaxed text-muted">
      Erasure, initialisation order, overload resolution, the memory model. Read the
      concept, then prove you have it — and run the code yourself when the answer
      surprises you.
    </p>
    <div class="mt-7 flex gap-3">
      <a href="/quiz" class="ui bg-ink px-5 py-2.5 text-sm text-paper">Start a quiz</a>
      <a href="/playground" class="ui border border-rule px-5 py-2.5 text-sm">Open the playground</a>
    </div>
  </section>

  {topics.map((topic) => (
    <section class="mb-12">
      <h2 class="eyebrow mb-4">{topic}</h2>
      <ul class="border-t border-rule">
        {concepts
          .filter((c) => c.data.topic === topic)
          .map((c) => (
            <li class="border-b border-rule">
              <a href={`/concepts/${c.id}`} class="flex gap-5 py-4 hover:bg-surface">
                <span class="gutter self-start pt-1">
                  {String(c.data.offset).padStart(4, "0")}
                </span>
                <span class="flex-1">
                  <span class="ui block font-medium">{c.data.title}</span>
                  <span class="mt-1 block max-w-2xl text-[0.94rem] leading-relaxed text-muted">
                    {c.data.definition}
                  </span>
                </span>
                <span class="eyebrow hidden shrink-0 self-center sm:block">
                  {countFor(c.id)} q · {"·".repeat(c.data.difficulty)}
                </span>
              </a>
            </li>
          ))}
      </ul>
    </section>
  ))}
</Base>
