---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import questionsEn from "../../data/questions.json";
import questionsFr from "../../data/questions.fr.json";
import { t, localizePath, type Lang } from "../../lib/i18n";

const { entry, lang = "en" as Lang } = Astro.props;
const s = t(lang);
const questions = lang === "fr" ? questionsFr : questionsEn;
const { Content } = await render(entry);
const related = questions.filter((q) => q.concept === entry.id);
---

<Base title={s.concept.pageTitle(entry.data.title)} description={entry.data.definition} lang={lang}>
  <a href={localizePath(lang, "/")} class="eyebrow hover:text-ink">&larr; {s.concept.allConcepts}</a>

  <article class="mt-6 flex gap-6">
    <div class="gutter hidden pt-2 sm:block">
      {String(entry.data.offset).padStart(4, "0")}
      <div class="mt-3 leading-relaxed">
        {entry.data.tags.map((tag: string) => <div>{tag}</div>)}
      </div>
    </div>

    <div class="min-w-0 flex-1">
      <span class="eyebrow">{entry.data.topic}{entry.data.source ? ` · ${entry.data.source}` : ""}</span>
      <h1 class="ui mt-2 text-3xl font-bold tracking-tight">{entry.data.title}</h1>

      <p class="mt-4 border-l-2 border-cobalt pl-5 text-[1.05rem] leading-relaxed">
        {entry.data.definition}
      </p>

      <div class="prose-note mt-10">
        <Content />
      </div>

      {related.length > 0 && (
        <div class="mt-14 border-t border-rule pt-6">
          <span class="eyebrow">{s.concept.questionsOnConcept(related.length)}</span>
          <a
            href={localizePath(lang, `/quiz?concept=${entry.id}`)}
            class="ui mt-3 block w-fit bg-ink px-5 py-2 text-sm text-paper"
          >
            {s.concept.drillIt}
          </a>
        </div>
      )}
    </div>
  </article>
</Base>
