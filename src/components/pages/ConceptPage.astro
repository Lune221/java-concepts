---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import questionsEn from "../../data/questions.json";
import questionsFr from "../../data/questions.fr.json";
import { t, localizePath, type Lang } from "../../lib/i18n";

const { entry, lang = "en" as Lang } = Astro.props;
const s = t(lang);
const questions = lang === "fr" ? questionsFr : questionsEn;
const { Content } = await render(entry);
const related = questions.filter((q) => q.concept === entry.id);

const orderedConcepts = (await getCollection(lang === "fr" ? "conceptsFr" : "concepts")).sort(
  (a, b) => a.data.offset - b.data.offset
);
const index = orderedConcepts.findIndex((c) => c.id === entry.id);
const prev = index > 0 ? orderedConcepts[index - 1] : null;
const next = index < orderedConcepts.length - 1 ? orderedConcepts[index + 1] : null;
---

<Base title={s.concept.pageTitle(entry.data.title)} description={entry.data.definition} lang={lang}>
  <a href={localizePath(lang, "/")} class="eyebrow hover:text-ink">&larr; {s.concept.allConcepts}</a>

  <article class="mt-6 flex gap-6">
    <div class="gutter hidden pt-2 sm:block">
      {String(entry.data.offset).padStart(4, "0")}
      <div class="mt-3 leading-relaxed">
        {entry.data.tags.map((tag: string) => <div>{tag}</div>)}
      </div>
    </div>

    <div class="min-w-0 flex-1">
      <span class="eyebrow">{entry.data.topic}{entry.data.source ? ` · ${entry.data.source}` : ""}</span>
      <h1 class="ui mt-2 text-3xl font-bold tracking-tight">{entry.data.title}</h1>

      <p class="mt-4 border-l-2 border-cobalt pl-5 text-[1.05rem] leading-relaxed">
        {entry.data.definition}
      </p>

      <div class="prose-note mt-10">
        <Content />
      </div>

      {related.length > 0 && (
        <div class="mt-14 border-t border-rule pt-6">
          <span class="eyebrow">{s.concept.questionsOnConcept(related.length)}</span>
          <a
            href={localizePath(lang, `/quiz?concept=${entry.id}`)}
            class="ui mt-3 block w-fit bg-ink px-5 py-2 text-sm text-paper"
          >
            {s.concept.drillIt}
          </a>
        </div>
      )}

      <nav class="mt-10 flex items-start justify-between gap-6 border-t border-rule pt-6">
        {prev ? (
          <a href={localizePath(lang, `/concepts/${prev.id}`)} class="group max-w-[45%]">
            <span class="eyebrow block">&larr; {s.concept.previous}</span>
            <span class="ui mt-1 block font-medium group-hover:text-cobalt">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {next ? (
          <a href={localizePath(lang, `/concepts/${next.id}`)} class="group ml-auto max-w-[45%] text-right">
            <span class="eyebrow block">{s.concept.next} &rarr;</span>
            <span class="ui mt-1 block font-medium group-hover:text-cobalt">{next.data.title}</span>
          </a>
        ) : (
          <span />
        )}
      </nav>
    </div>
  </article>
</Base>

<script>
  import { markConceptRead } from "../../lib/progress";
  // The slug is the last path segment for both /concepts/:slug and /fr/concepts/:slug.
  const slug = location.pathname.replace(/\/$/, "").split("/").pop();
  if (slug) markConceptRead(slug);
</script>
